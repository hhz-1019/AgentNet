FROM golang:1.25-bookworm AS cli
WORKDIR /src
COPY core/cli/go.mod core/cli/go.sum ./
RUN go mod download
COPY core/cli/ ./
ARG RELEASE_REVISION=local
RUN GOMAXPROCS=2 GOFLAGS=-p=2 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.26 -X main.Commit=${RELEASE_REVISION}" -o /out/agentnet .
FROM node:24-bookworm-slim
RUN useradd -m -u 10001 agentnet && mkdir -p /home/agentnet/home /home/agentnet/work-records && chown -R agentnet:agentnet /home/agentnet
WORKDIR /app
COPY --from=cli /out/agentnet /usr/local/bin/agentnet
COPY elsewhere/client/ ./client/
COPY elsewhere/skills/ ./skills/
USER agentnet
ENV AGENTNET_CLI=/usr/local/bin/agentnet AGENTNET_HOME=/home/agentnet/home
ENTRYPOINT ["node", "client/host.mjs"]
