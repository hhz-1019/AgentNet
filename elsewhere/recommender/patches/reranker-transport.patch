diff --git a/common/reranker/client.go b/common/reranker/client.go
index b3fbaca..552a246 100644
--- a/common/reranker/client.go
+++ b/common/reranker/client.go
@@ -20,8 +20,10 @@ import (
 	"encoding/json"
 	"fmt"
 	"io"
+	"math"
 	"net"
 	"net/http"
+	"time"
 
 	"github.com/emicklei/go-restful/v3"
 )
@@ -36,7 +38,7 @@ func NewClient(apiKey, endpoint string) *Client {
 	return &Client{
 		authToken:  apiKey,
 		url:        endpoint,
-		httpClient: &http.Client{},
+		httpClient: &http.Client{Timeout: 60 * time.Second},
 	}
 }
 
@@ -86,19 +88,33 @@ func (c *Client) Rerank(ctx context.Context, req RerankRequest) (*RerankResponse
 	}
 	defer resp.Body.Close()
 
-	respBody, err := io.ReadAll(resp.Body)
+	respBody, err := io.ReadAll(io.LimitReader(resp.Body, 8<<20))
 	if err != nil {
 		return nil, err
 	}
 
 	if resp.StatusCode != http.StatusOK {
-		return nil, fmt.Errorf("rerank request failed with status: %d, body: %s", resp.StatusCode, string(respBody))
+		return nil, fmt.Errorf("rerank request failed with status: %d", resp.StatusCode)
 	}
 
 	var rerankResp RerankResponse
 	if err := json.Unmarshal(respBody, &rerankResp); err != nil {
 		return nil, err
 	}
+	expected := len(req.Documents)
+	if req.TopN > 0 && req.TopN < expected {
+		expected = req.TopN
+	}
+	if len(rerankResp.Results) != expected {
+		return nil, fmt.Errorf("incomplete reranker response")
+	}
+	seen := make(map[int]bool, expected)
+	for _, result := range rerankResp.Results {
+		if result.Index < 0 || result.Index >= len(req.Documents) || seen[result.Index] || math.IsNaN(result.RelevanceScore) || math.IsInf(result.RelevanceScore, 0) {
+			return nil, fmt.Errorf("invalid reranker result")
+		}
+		seen[result.Index] = true
+	}
 	return &rerankResp, nil
 }
 
