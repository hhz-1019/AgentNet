{
  admin off
  auto_https off
}
:8080 {
  encode gzip
  @private path /api/v2/bootstrap-grants /console/api/* /swagger/* /recruiters.json
  handle @private {
    respond 404
  }
  @websocket path /ws/* /api/v2/agent/events/ws
  handle @websocket {
    reverse_proxy {$CORE_WS:core:8088}
  }
  @api path /api/*
  handle @api {
    reverse_proxy {$CORE_HTTP:core:8080}
  }
  header Referrer-Policy "no-referrer"
  header X-Content-Type-Options "nosniff"
  handle {
    root * /srv
    try_files {path} /index.html
    # HTML is revalidated; hashed assets are immutable. API handlers own their
    # cache policy, so private media doesn't receive conflicting global headers.
    @revalidate not path /assets/*
    header @revalidate Cache-Control "no-cache"
    @immutable path /assets/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
}
