FROM golang:1.25-bookworm AS clients
WORKDIR /src
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOMAXPROCS=2 GOFLAGS=-p=2 CGO_ENABLED=0
COPY core/cli/go.mod core/cli/go.sum ./
RUN go mod download
COPY core/cli/ ./
COPY LICENSE ./LICENSE
ARG RELEASE_REVISION=local
RUN mkdir -p /out && \
    GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.26 -X main.Commit=${RELEASE_REVISION}" -o /out/agentnet-linux-amd64 . && \
    GOOS=linux GOARCH=arm64 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.26 -X main.Commit=${RELEASE_REVISION}" -o /out/agentnet-linux-arm64 . && \
    GOOS=darwin GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.26 -X main.Commit=${RELEASE_REVISION}" -o /out/agentnet-darwin-amd64 . && \
    GOOS=darwin GOARCH=arm64 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.26 -X main.Commit=${RELEASE_REVISION}" -o /out/agentnet-darwin-arm64 . && \
    GOOS=windows GOARCH=amd64 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.26 -X main.Commit=${RELEASE_REVISION}" -o /out/agentnet-windows-amd64.exe . && \
    GOOS=windows GOARCH=arm64 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.26 -X main.Commit=${RELEASE_REVISION}" -o /out/agentnet-windows-arm64.exe . && \
    cd /out && for file in agentnet-*; do sha256sum "$file" > "$file.sha256"; done && \
    cp /src/LICENSE /out/LICENSE-Elsewhere.txt && \
    printf 'elsewhere CLI\nSource: https://github.com/hhz-1019/AgentNet\nRevision: %s\n' "$RELEASE_REVISION" > /out/SOURCE.txt

FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev
COPY elsewhere/web ./elsewhere/web
COPY core/api/consolev2/celebrity_catalog.json ./core/api/consolev2/celebrity_catalog.json
COPY elsewhere/skills/agentnet-onboarding ./elsewhere/web/public/agentnet-onboarding
COPY elsewhere/skills/agentnet-social ./elsewhere/web/public/agentnet-social
COPY elsewhere/skills/agentnet-handoff ./elsewhere/web/public/agentnet-handoff
COPY --from=clients /out ./elsewhere/web/public/downloads
ARG RELEASE_REVISION=local
RUN RELEASE_REVISION="$RELEASE_REVISION" node -e 'const fs=require("fs"),p="elsewhere/web/public/release.json",r=JSON.parse(fs.readFileSync(p));r.revision=process.env.RELEASE_REVISION;fs.writeFileSync(p,JSON.stringify(r,null,2)+"\n")'
RUN npx vite build --config elsewhere/web/vite.config.mjs
FROM caddy:2-alpine
COPY --from=build /app/dist-core /srv
COPY elsewhere/Caddyfile /etc/caddy/Caddyfile
EXPOSE 8080
