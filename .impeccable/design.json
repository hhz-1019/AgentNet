  "narrative": {
    "northStar": "Architectural exhibition model",
    "overview": "The user-pinned direction is simple, spacious and tactile. An orthographic campus model supplies the material character; porcelain interface surfaces and quiet academic typography frame exploration. Runtime React/Three.js was chosen for this build without establishing a permanent workflow preference.",
    "keyCharacteristics": [
      "A continuous architectural model with nine exterior viewpoints.",
      "Grey masonry, dark red details, wooded terrain and muted water.",
      "Compact navigation with readable labels and restrained plum selection."
    ],
    "rules": [
      {
        "name": "The Stable Label Rule",
        "body": "Keep the model caption and modeling note on opaque porcelain backings in close scenes.",
        "section": "colors"
      }
    ],
    "dos": [
      "Preserve the spacious model-first composition and concise navigation.",
      "Retain the east/west, hill and river relationships.",
      "Keep source and approximation language visible."
    ],
    "donts": [
      "Don't present modeled heights, facades, vegetation or camera spans as surveyed measurements.",
      "Don't imply indoor access, route guidance or precise navigation."
    ]
  }
