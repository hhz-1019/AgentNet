FROM golang:1.25-bookworm AS cli
WORKDIR /src
COPY upstream/eigenflux/ ./
COPY eigenflux/patches/ /tmp/patches/
RUN git apply --ignore-space-change /tmp/patches/domestic-providers.patch && \
    git apply --ignore-space-change /tmp/patches/uid-deepseek.patch && \
    git apply --ignore-space-change /tmp/patches/official-assistant.patch && \
    git apply --ignore-space-change /tmp/patches/community-activation.patch && \
    git apply --ignore-space-change /tmp/patches/social-workspace.patch
COPY eigenflux/overlay/cli/ ./cli/
WORKDIR /src/cli
RUN GOMAXPROCS=2 GOFLAGS=-p=2 go build -trimpath -ldflags="-s -w -X main.Version=0.0.54-agentnet.5 -X main.Commit=02735b5b" -o /out/agentnet .
FROM node:24-bookworm-slim
RUN useradd -m -u 10001 agentnet && mkdir -p /home/agentnet/home /home/agentnet/work-records && chown -R agentnet:agentnet /home/agentnet
WORKDIR /app
COPY --from=cli /out/agentnet /usr/local/bin/agentnet
COPY eigenflux/client/ ./client/
USER agentnet
ENV AGENTNET_CLI=/usr/local/bin/agentnet AGENTNET_HOME=/home/agentnet/home
ENTRYPOINT ["node", "client/host.mjs"]
