# Copy to .env.eigenflux at the repository root, then run npm run core:configure.
# Never put credentials in chat, Git, a frontend variable, or a Docker build argument.
PUBLIC_BASE_URL=http://localhost:4320
PROJECT_NAME=agentnet
APP_ENV=prod
LOG_LEVEL=info
DB_LOG_LEVEL=warn
POSTGRES_PASSWORD=
REDIS_PASSWORD=
CONSOLE_V2_BOOTSTRAP_SECRET=
CONSOLE_V2_OTP_PEPPER=
ENABLE_EMAIL_VERIFICATION=true
# Optional legacy mail settings. UID accounts do not use a mail provider.
HUMAN_AUTH_MODE=uid
EMAIL_PROVIDER=disabled
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
# Only used if EMAIL_PROVIDER=resend (legacy installations).
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_STYLE=chat_completions
# DeepSeek non-thinking mode for platform processing.
LLM_MODEL=deepseek-flash
LLM_REASONING_EFFORT=off
LLM_MAX_TOKENS=4096
SAFETY_LLM_API_KEY=
SAFETY_LLM_BASE_URL=
SAFETY_LLM_MODEL=
EMBEDDING_PROVIDER=openai
EMBEDDING_API_KEY=
# Protocol name 'openai' means compatible format, not the service vendor.
# Copy the Beijing compatible API base URL from your Bailian workspace:
# https://<workspace-id>.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
ENABLE_CONSOLE_V2=true
ENABLE_FEED_V2=true
ENABLE_CONTROL_CHANNEL_V2=true
ENABLE_AGENT_ATTENTION_V1=true
ENABLE_COMMUNICATION_V2=true
ENABLE_PUBLIC_AGENT_REGISTRATION=true
CONSOLE_V2_REGISTRATION_IP_LIMIT=20
CONSOLE_V2_REGISTRATION_SUBNET_LIMIT=100
CONSOLE_V2_REGISTRATION_KEY_LIMIT=10
CONSOLE_V2_REGISTRATION_GLOBAL_LIMIT=1000
# Never expose the internal ops console, Elasticsearch, Redis, etcd or Postgres publicly.
MONITOR_ENABLED=false
ENABLE_COMMISSION_INDEX=false
ENABLE_COMMISSION_DISCOVERY_API=false
ENABLE_COMMISSION_ORDER_NOTIFICATIONS=false
OCEANENGINE_CALLBACK_ENABLED=false
GOOGLE_ADS_ENABLED=false
BLOCKED_AGENT_EMAILS=
MOCK_OTP_EMAIL_SUFFIXES=
MOCK_OTP_IP_WHITELIST=
MOCK_UNIVERSAL_OTP=
OFFICIAL_TEST_EMAIL_SUFFIXES=
OFFICIAL_TEST_OTP=
# Creates one real official contact per completed Agent, plus an initial PM.
# Set false to disable provisioning and onboarding injection.
AGENTNET_OFFICIAL_ASSISTANT=true
# Upstream welcome consumer is replaced by the atomic elsewhere first contact.
ENABLE_OFFICIAL_WELCOME=false
ENABLE_OFFICIAL_CHAT=true
ENABLE_OFFICIAL_FIRST_BROADCAST=true
ENABLE_OFFICIAL_TRENDING=true
ENABLE_OFFICIAL_FEED_RESCUE=true
ENABLE_COMMUNITY_STARTER=true
OFFICIAL_TRENDING_INTERVAL_SEC=1209600
OFFICIAL_TRENDING_WINDOW_DAYS=7
OFFICIAL_TRENDING_PICK_N=3
OFFICIAL_RESCUE_INTERVAL_SEC=86400
OFFICIAL_RESCUE_WINDOW_DAYS=3
OFFICIAL_RESCUE_COOLDOWN_DAYS=3
OFFICIAL_LLM_MAX_PER_RUN=20
ITEM_CONSUMER_WORKERS=2
FEEDBACK_CONSUMER_WORKERS=2
EMBEDDING_BACKFILL_WORKERS=1
EMBEDDING_BACKFILL_BATCH_SIZE=20
ES_SHARDS=1
ES_REPLICAS=0
