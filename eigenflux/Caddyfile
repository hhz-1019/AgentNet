{
  admin off
  auto_https off
}
:8080 {
  encode gzip
  @private path /api/v2/bootstrap-grants /console/api/* /swagger/*
  handle @private {
    respond 404
  }
  @websocket path /ws/* /api/v2/agent/events/ws
  handle @websocket {
    reverse_proxy {$CORE_WS:core:8088}
  }
  @api path /api/*
  handle @api {
    reverse_proxy {$CORE_HTTP:core:8080}
  }
  header Referrer-Policy "no-referrer"
  header X-Content-Type-Options "nosniff"
  header Cache-Control "no-cache"
  handle {
    root * /srv
    try_files {path} /index.html
    file_server
  }
}
