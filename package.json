{
  "name": "agentnet",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "dev": "vite --config eigenflux/web/vite.config.mjs",
    "build": "vite build --config eigenflux/web/vite.config.mjs && npm run build:moment-panel",
    "start": "docker compose --env-file .env.eigenflux -f eigenflux/compose.yaml up -d --build",
    "typecheck": "tsc -p eigenflux/web/tsconfig.json",
    "test": "node --test eigenflux/recommender/sync.test.mjs eigenflux/client/recommendations.test.mjs eigenflux/scripts/check.test.mjs eigenflux/web/onboarding.test.ts eigenflux/web/onboarding-prefill.test.ts eigenflux/web/preview-data.test.ts eigenflux/web/guest-data.test.ts eigenflux/web/social/model.test.ts eigenflux/web/social/feed-pages.test.ts eigenflux/web/brand-entry.test.ts eigenflux/web/social/journal-wind.test.ts eigenflux/web/social/message-history.test.ts eigenflux/client/work.test.mjs eigenflux/client/runtime.test.mjs eigenflux/client/activity.test.mjs eigenflux/client/context.test.mjs eigenflux/client/handoff.test.mjs eigenflux/client/prompts.test.mjs eigenflux/scripts/broadcast-social-migration.test.mjs eigenflux/client/decisions.test.mjs eigenflux/client/codex-executor.test.mjs eigenflux/web/social/moment-model.test.ts eigenflux/client/chat-decisions.test.mjs eigenflux/web/companion.test.ts eigenflux/client/activity-report.test.mjs eigenflux/client/grounding.test.mjs eigenflux/scripts/social-permissions-migration.test.mjs eigenflux/web/entry-route.test.ts eigenflux/web/avatar-cache.test.ts eigenflux/web/session-refresh.test.ts eigenflux/web/feedback-message.test.ts eigenflux/web/plain-text.test.ts eigenflux/web/pending-reads.test.ts eigenflux/web/read-cache.test.ts eigenflux/web/social/loading.test.ts eigenflux/scripts/host-memory-contract.test.mjs eigenflux/web/registration-profile.test.ts eigenflux/scripts/onboarding-origin.test.mjs eigenflux/client/connection-deletion.test.mjs",
    "lint": "oxlint -c eigenflux/.oxlintrc.json eigenflux/web eigenflux/client eigenflux/scripts",
    "format": "oxfmt eigenflux/web eigenflux/client eigenflux/scripts",
    "core:configure": "node eigenflux/scripts/configure.mjs",
    "core:check": "node eigenflux/scripts/check.mjs",
    "core:providers": "node eigenflux/scripts/provider-smoke.mjs",
    "core:check:offline": "node eigenflux/scripts/check.mjs --defer-providers",
    "core:smoke": "node eigenflux/scripts/smoke.mjs",
    "core:mcp:smoke": "node eigenflux/scripts/mcp-smoke.mjs",
    "core:broadcast:smoke": "node eigenflux/scripts/broadcast-smoke.mjs",
    "deploy:package": "node eigenflux/scripts/package-deploy.mjs",
    "server:hk": "node eigenflux/scripts/hk.mjs",
    "deploy:hk": "node eigenflux/scripts/hk.mjs deploy",
    "test:deploy:hk": "node --test eigenflux/scripts/hk.test.mjs",
    "test:social:core": "node eigenflux/scripts/social-core-test.mjs",
    "test:social:ui": "node eigenflux/scripts/social-ui-smoke.mjs",
    "test:messages:ui": "node eigenflux/scripts/messages-ui-smoke.mjs",
    "test:twin:ui": "node eigenflux/scripts/twin-ui-smoke.mjs",
    "test:demo:ui": "node eigenflux/scripts/demo-polish-smoke.mjs",
    "test:social:live": "node eigenflux/scripts/social-core-test.mjs --browser",
    "agent:host": "node eigenflux/client/host.mjs",
    "test:host:protocol": "node eigenflux/scripts/host-protocol-test.mjs",
    "test:phone:core": "node eigenflux/scripts/phone-auth-test.mjs",
    "test:phone:ui": "node eigenflux/scripts/phone-ui-smoke.mjs",
    "test:managed:core": "node eigenflux/scripts/managed-core-test.mjs",
    "test:analytics:core": "node eigenflux/scripts/managed-core-test.mjs --analytics",
    "test:analytics:ui": "node eigenflux/scripts/analytics-ui-smoke.mjs",
    "test:members:ui": "node eigenflux/scripts/admin-members-ui-smoke.mjs",
    "test:registration:ui": "node eigenflux/scripts/registration-ui-smoke.mjs",
    "test:managed:ui": "node eigenflux/scripts/managed-ui-smoke.mjs",
    "test:appearance:ui": "node eigenflux/scripts/appearance-ui-smoke.mjs",
    "test:interface:ui": "node eigenflux/scripts/interface-ui-smoke.mjs",
    "test:mobile:ui": "node eigenflux/scripts/mobile-ui-smoke.mjs",
    "test:icons:ui": "node eigenflux/scripts/icons-ui-smoke.mjs",
    "test:guest:ui": "node eigenflux/scripts/guest-entry-ui-smoke.mjs",
    "test:moment:core": "node eigenflux/scripts/social-core-test.mjs --moment",
    "agent:decisions": "node eigenflux/client/host.mjs --decisions-only --once",
    "build:moment-panel": "node eigenflux/scripts/build-moment-panel.mjs",
    "test:moment:ui": "node eigenflux/scripts/moment-ui-smoke.mjs && node eigenflux/scripts/moment-interactions-ui.mjs",
    "test:moment:live": "node eigenflux/scripts/social-core-test.mjs --moment --browser",
    "test:performance": "node --test eigenflux/web/pending-reads.test.ts eigenflux/scripts/social-read-index.test.mjs && node eigenflux/scripts/performance-ui-smoke.mjs",
    "test:alignment:ui": "node eigenflux/scripts/visual-alignment-ui.mjs",
    "test:discovery:ui": "node eigenflux/scripts/discovery-ui.mjs",
    "test:scroll:ui": "node eigenflux/scripts/scroll-layout-ui.mjs",
    "test:performance:acceptance": "node eigenflux/scripts/performance-acceptance.mjs",
    "test:entry": "npm run build && node eigenflux/scripts/entry-acceptance.mjs",
    "test:performance:unit": "node --test eigenflux/web/brand-entry.test.ts eigenflux/web/read-policy.test.ts eigenflux/web/performance-metrics.test.ts eigenflux/web/social/loading.test.ts",
    "test:recommendations:live": "node eigenflux/scripts/recommendation-live-test.mjs",
    "test:registration:profile": "node --test eigenflux/web/registration-profile.test.ts && node eigenflux/scripts/registration-profile-ui.mjs",
    "test:onboarding:installer": "node eigenflux/scripts/installer-protocol-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-vitals": "6.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
