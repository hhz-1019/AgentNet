    "start": "docker compose --env-file .env.elsewhere -f elsewhere/compose.yaml up -d --build",
    "typecheck": "tsc -p elsewhere/web/tsconfig.json",
    "test": "node --test elsewhere/recommender/sync.test.mjs elsewhere/client/recommendations.test.mjs elsewhere/scripts/check.test.mjs elsewhere/web/onboarding.test.ts elsewhere/web/onboarding-prefill.test.ts elsewhere/web/preview-data.test.ts elsewhere/web/guest-data.test.ts elsewhere/web/social/model.test.ts elsewhere/web/social/feed-pages.test.ts elsewhere/web/brand-entry.test.ts elsewhere/web/social/journal-wind.test.ts elsewhere/web/social/message-history.test.ts elsewhere/client/work.test.mjs elsewhere/client/runtime.test.mjs elsewhere/client/activity.test.mjs elsewhere/client/context.test.mjs elsewhere/client/handoff.test.mjs elsewhere/client/prompts.test.mjs elsewhere/scripts/broadcast-social-migration.test.mjs elsewhere/client/decisions.test.mjs elsewhere/client/codex-executor.test.mjs elsewhere/web/social/moment-model.test.ts elsewhere/client/chat-decisions.test.mjs elsewhere/web/companion.test.ts elsewhere/client/activity-report.test.mjs elsewhere/client/grounding.test.mjs elsewhere/scripts/social-permissions-migration.test.mjs elsewhere/web/entry-route.test.ts elsewhere/web/avatar-cache.test.ts elsewhere/web/session-refresh.test.ts elsewhere/web/feedback-message.test.ts elsewhere/web/plain-text.test.ts elsewhere/web/pending-reads.test.ts elsewhere/web/read-cache.test.ts elsewhere/web/social/loading.test.ts elsewhere/scripts/host-memory-contract.test.mjs elsewhere/web/registration-profile.test.ts elsewhere/scripts/onboarding-origin.test.mjs elsewhere/client/activity-context.test.mjs elsewhere/scripts/activity-workflows.test.mjs elsewhere/client/connection-deletion.test.mjs",
    "lint": "oxlint -c elsewhere/.oxlintrc.json elsewhere/web elsewhere/client elsewhere/scripts",
    "format": "oxfmt elsewhere/web elsewhere/client elsewhere/scripts",
    "core:configure": "node elsewhere/scripts/configure.mjs",
    "core:check": "node elsewhere/scripts/check.mjs",
    "core:providers": "node elsewhere/scripts/provider-smoke.mjs",
    "core:check:offline": "node elsewhere/scripts/check.mjs --defer-providers",
    "core:smoke": "node elsewhere/scripts/smoke.mjs",
    "core:mcp:smoke": "node elsewhere/scripts/mcp-smoke.mjs",
    "core:broadcast:smoke": "node elsewhere/scripts/broadcast-smoke.mjs",
    "deploy:package": "node elsewhere/scripts/package-deploy.mjs",
    "server:hk": "node elsewhere/scripts/hk.mjs",
    "deploy:hk": "node elsewhere/scripts/hk.mjs deploy",
    "test:deploy:hk": "node --test elsewhere/scripts/hk.test.mjs elsewhere/scripts/ci-release-artifacts.test.mjs elsewhere/scripts/aliyun-hk-code-compose.test.mjs",
    "test:social:core": "node elsewhere/scripts/social-core-test.mjs",
    "test:social:ui": "node elsewhere/scripts/social-ui-smoke.mjs",
    "test:messages:ui": "node elsewhere/scripts/messages-ui-smoke.mjs",
    "test:twin:ui": "node elsewhere/scripts/twin-ui-smoke.mjs",
    "test:demo:ui": "node elsewhere/scripts/demo-polish-smoke.mjs",
    "test:social:live": "node elsewhere/scripts/social-core-test.mjs --browser",
    "agent:host": "node elsewhere/client/host.mjs",
    "test:host:protocol": "node elsewhere/scripts/host-protocol-test.mjs",
    "test:phone:core": "node elsewhere/scripts/phone-auth-test.mjs",
    "test:phone:ui": "node elsewhere/scripts/phone-ui-smoke.mjs",
    "test:managed:core": "node elsewhere/scripts/managed-core-test.mjs",
    "test:analytics:core": "node elsewhere/scripts/managed-core-test.mjs --analytics",
    "test:analytics:ui": "node elsewhere/scripts/analytics-ui-smoke.mjs",
    "test:members:ui": "node elsewhere/scripts/admin-members-ui-smoke.mjs",
    "test:registration:ui": "node elsewhere/scripts/registration-ui-smoke.mjs",
    "test:managed:ui": "node elsewhere/scripts/managed-ui-smoke.mjs",
    "test:appearance:ui": "node elsewhere/scripts/appearance-ui-smoke.mjs",
    "test:interface:ui": "node elsewhere/scripts/interface-ui-smoke.mjs",
    "test:mobile:ui": "node elsewhere/scripts/mobile-ui-smoke.mjs",
    "test:icons:ui": "node elsewhere/scripts/icons-ui-smoke.mjs",
    "test:guest:ui": "node elsewhere/scripts/guest-entry-ui-smoke.mjs",
    "test:moment:core": "node elsewhere/scripts/social-core-test.mjs --moment",
    "agent:decisions": "node elsewhere/client/host.mjs --decisions-only --once",
    "build:moment-panel": "node elsewhere/scripts/build-moment-panel.mjs",
    "test:moment:ui": "node elsewhere/scripts/moment-ui-smoke.mjs && node elsewhere/scripts/moment-interactions-ui.mjs",
    "test:moment:live": "node elsewhere/scripts/social-core-test.mjs --moment --browser",
    "test:performance": "node --test elsewhere/web/pending-reads.test.ts elsewhere/scripts/social-read-index.test.mjs && node elsewhere/scripts/performance-ui-smoke.mjs",
    "test:alignment:ui": "node elsewhere/scripts/visual-alignment-ui.mjs",
    "test:discovery:ui": "node elsewhere/scripts/discovery-ui.mjs",
    "test:scroll:ui": "node elsewhere/scripts/scroll-layout-ui.mjs",
    "test:performance:acceptance": "node elsewhere/scripts/performance-acceptance.mjs",
    "test:entry": "npm run build && node elsewhere/scripts/entry-acceptance.mjs",
    "test:performance:unit": "node --test elsewhere/web/brand-entry.test.ts elsewhere/web/read-policy.test.ts elsewhere/web/performance-metrics.test.ts elsewhere/web/social/loading.test.ts",
    "test:recommendations:live": "node elsewhere/scripts/recommendation-live-test.mjs",
    "test:registration:profile": "node --test elsewhere/web/registration-profile.test.ts && node elsewhere/scripts/registration-profile-ui.mjs",
    "test:onboarding:installer": "node elsewhere/scripts/installer-protocol-test.mjs",
    "check:activity-workflows": "node elsewhere/scripts/sync-activity-workflows.mjs --check",
    "check:brand": "node elsewhere/scripts/check-brand.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/sdk": "1.30.0",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "web-vitals": "6.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
