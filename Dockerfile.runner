FROM node:24.14.0-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY scripts ./scripts
COPY lib/world-decision.ts lib/character-settings.ts lib/world-collaboration.ts lib/world-places.json ./lib/
ENV RUN_MODE=continuous RUNNER_DATA_DIR=/data/runner AGENT_BRAIN=api
CMD ["node", "scripts/campus-runner.mjs"]
